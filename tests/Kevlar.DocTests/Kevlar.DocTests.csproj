<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kevlar" Version="$(KevlarPackageVersion)" />
    <PackageReference Include="Kevlar.Analyzers" Version="$(KevlarPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Kevlar.Extensions.DependencyInjection" Version="$(KevlarPackageVersion)" />
    <PackageReference Include="Kevlar.Extensions.Http" Version="$(KevlarPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedSnippetsPath)" Link="GeneratedSnippets.g.cs" />
  </ItemGroup>

</Project>
