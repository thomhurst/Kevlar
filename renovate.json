{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:monorepos"],
  "packageRules": [
    {
      "description": "Update interdependent gRPC packages together to avoid NuGet downgrades",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Grpc.*"],
      "groupName": "gRPC packages"
    }
  ]
}
