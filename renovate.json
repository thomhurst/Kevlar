{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:monorepos"],
  "packageRules": [
    {
      "description": "Update interdependent gRPC packages together to avoid NuGet downgrades",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Grpc.*"],
      "groupName": "gRPC packages"
    },
    {
      "description": "Keep netstandard dependency floors on the 8.x line while allowing compatible updates",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": [
        "Microsoft.Bcl.AsyncInterfaces",
        "Microsoft.Bcl.TimeProvider",
        "Microsoft.Extensions.*",
        "Microsoft.EntityFrameworkCore.*",
        "Npgsql.EntityFrameworkCore.PostgreSQL",
        "System.Threading.RateLimiting"
      ],
      "matchCurrentVersion": "<9.0.0",
      "allowedVersions": "<9.0.0"
    },
    {
      "description": "Keep net10.0 dependency versions on the 10.x line while allowing compatible updates",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": [
        "Microsoft.EntityFrameworkCore.*",
        "Microsoft.Extensions.Configuration",
        "Microsoft.Extensions.Configuration.Json",
        "Microsoft.Extensions.Configuration.Abstractions",
        "Microsoft.Extensions.DependencyInjection",
        "Microsoft.Extensions.DependencyInjection.Abstractions",
        "Microsoft.Extensions.Diagnostics.HealthChecks",
        "Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions",
        "Microsoft.Extensions.Hosting",
        "Microsoft.Extensions.Http",
        "Microsoft.Extensions.Logging",
        "Microsoft.Extensions.Logging.Abstractions",
        "Microsoft.Extensions.Options",
        "Microsoft.Extensions.Primitives",
        "Microsoft.Extensions.TimeProvider.Testing",
        "Npgsql.EntityFrameworkCore.PostgreSQL",
        "System.Threading.RateLimiting"
      ],
      "matchCurrentVersion": ">=10.0.0 <11.0.0",
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Keep net11.0 dependency versions on the 11.x line while allowing compatible updates",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": [
        "Microsoft.EntityFrameworkCore.*",
        "Microsoft.Extensions.Configuration",
        "Microsoft.Extensions.Configuration.Json",
        "Microsoft.Extensions.Configuration.Abstractions",
        "Microsoft.Extensions.DependencyInjection",
        "Microsoft.Extensions.DependencyInjection.Abstractions",
        "Microsoft.Extensions.Diagnostics.HealthChecks",
        "Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions",
        "Microsoft.Extensions.Hosting",
        "Microsoft.Extensions.Http",
        "Microsoft.Extensions.Logging",
        "Microsoft.Extensions.Logging.Abstractions",
        "Microsoft.Extensions.Options",
        "Microsoft.Extensions.Primitives",
        "Microsoft.Extensions.TimeProvider.Testing",
        "Npgsql.EntityFrameworkCore.PostgreSQL",
        "System.Threading.RateLimiting"
      ],
      "matchCurrentVersion": ">=11.0.0-0 <12.0.0",
      "allowedVersions": "<12.0.0"
    }
  ]
}
