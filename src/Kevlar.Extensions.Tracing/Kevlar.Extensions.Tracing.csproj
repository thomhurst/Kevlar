<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Kevlar.Extensions.Tracing</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>Opt-in enrichment of application activities with Kevlar telemetry events.</Description>
    <PackageTags>resilience;tracing;opentelemetry;kevlar</PackageTags>
    <PinKevlarDependencyVersion>true</PinKevlarDependencyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kevlar\Kevlar.csproj" PrivateAssets="Build" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>
</Project>
