<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <Description>Sequential Kevlar execution strategies for Entity Framework Core.</Description>
    <PackageTags>resilience;entity-framework-core;database;kevlar</PackageTags>
    <PinKevlarDependencyVersion>true</PinKevlarDependencyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kevlar\Kevlar.csproj" PrivateAssets="Build" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
